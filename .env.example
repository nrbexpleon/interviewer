PORT=3000
DATA_DIR=./data

# Safe defaults for local development. Lab deployment overrides these values.
DEPLOYMENT_MODE=local
DATA_MODE=synthetic
AUTH_TENANT_ID=
ALLOWED_TENANT_ID=
# Expleo production tenant is blocked for this development MVP.
BLOCKED_TENANT_IDS=3b0e7247-e0d5-44bf-8ed1-d01b18d16ca2
ALLOW_MOCK_GRAPH=true

AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_API_KEY=
